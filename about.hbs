<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>tinyAgentAccess third-party licenses</title>
<style>body{max-width:80ch;margin:2rem auto;padding:0 1rem;font-family:system-ui,sans-serif}pre{white-space:pre-wrap;overflow-wrap:anywhere}section{border-top:1px solid #888;margin-top:2rem}</style>
</head>
<body>
<h1>tinyAgentAccess third-party licenses</h1>
<p>Full license texts for the CLI dependency graph across all release targets. Generated by cargo-about.</p>
{{#each licenses}}
<section>
<h2>{{name}}</h2>
<ul>
{{#each used_by}}
<li>{{crate.name}} {{crate.version}}{{#if crate.repository}} — <a href="{{crate.repository}}">source</a>{{/if}}</li>
{{/each}}
</ul>
<pre>{{text}}</pre>
</section>
{{/each}}
</body>
</html>
